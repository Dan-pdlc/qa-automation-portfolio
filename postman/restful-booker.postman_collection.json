    {
      "name": "TC-API-09 Lista las reservas",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Responde 200', () => pm.response.to.have.status(200));",
              "const lista = pm.response.json();",
              "pm.test('Es una lista con ids numéricos', () => {",
              "  pm.expect(lista).to.be.an('array').that.is.not.empty;",
              "  pm.expect(lista[0].bookingid).to.be.a('number');",
              "});"
            ]
          }
        }
