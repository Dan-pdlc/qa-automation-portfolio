{
  "name": "qa-automation-portfolio",
  "version": "1.0.0",
  "description": "Automatización de pruebas web y API con Playwright (JavaScript)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=web",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=web --headed",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.saucedemo.com"
  },
  "keywords": ["qa", "playwright", "automation", "api-testing"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0"
  }
}
